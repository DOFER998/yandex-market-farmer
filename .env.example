# make setup-env creates .env with a random database password; mode 600.
BOT__TOKEN=replace_with_bot_token
BOT__OWNER_ID=123456789
POSTGRES__HOST=127.0.0.1
POSTGRES__PORT=15432
POSTGRES__USER=ymf
POSTGRES__PASSWORD=replace_with_random_password
POSTGRES__DATABASE=ymf
APP__DEBUG=false
APP__HEARTBEAT_FILE=.secrets/runtime/heartbeat
MARKET__SESSION_DIR=.secrets/accounts
MARKET__INTERVAL_SECONDS=2
# Linux VPS: UID/GID of the non-root owner of .secrets/accounts.
YMF_UID=1000
YMF_GID=1000

# Published release: set a version that actually exists in GHCR.
# YMF_IMAGE=ghcr.io/dofer998/yandex-market-farmer:0.1.0
